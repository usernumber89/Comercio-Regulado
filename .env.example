# ===========================================================================
# CONEXIÓN A LA BASE DE DATOS
# ---------------------------------------------------------------------------
# Este archivo es local: cada quien tiene el suyo y no se sube al repositorio.
# La plantilla está en `.env.example`.
#
# En Neon el panel da dos conexiones y acá se necesitan las dos:
#
#   DATABASE_URL  La del pooler. Es la que usa la aplicación. Su host lleva
#                 «-pooler» en el medio y termina en `-pooler.neon.tech`.
#
#   DIRECT_URL    La directa, sin pooler. Solo la usa la terminal de Prisma
#                 para crear las tablas (`npx prisma migrate deploy`).
#
# `connect_timeout=10` porque Neon apaga el servidor a los 5 minutos de no
# recibir consultas: si alguien abre la aplicación después de un rato, el
# primer arranque tarda unos segundos y sin esta espera la conexión se cae.
# ===========================================================================

DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-XXXX-pooler.REGION.neon.tech/neondb?sslmode=require&connect_timeout=10"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-XXXX.REGION.neon.tech/neondb?sslmode=require&connect_timeout=10"
API_REST_URL="https://ep-summer-forest-b40puzov.apirest.c-6.us-east-2.aws.neon.tech/neondb/rest/v1"

# Acceso administrativo (12+ caracteres y un secreto aleatorio de 32+ bytes).
# Si quedan vacíos, Configuración y las escrituras administrativas permanecen bloqueadas.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""